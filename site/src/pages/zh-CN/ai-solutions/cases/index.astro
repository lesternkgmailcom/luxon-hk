---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CaseStudyCard from '../../../../components/ai-solutions/CaseStudyCard.astro';
import { getTranslations } from '../../../../i18n/utils';

const t = getTranslations('zh-CN');
const ci = t.casesIndex;
const lp = (path: string) => `/zh-CN${path}`;

const caseStudies = [
  { title: ci.caseStudies.oceanFreight.title, description: ci.caseStudies.oceanFreight.description, href: lp('/ai-solutions/cases/ocean-freight-dashboard'), tag: ci.caseStudies.oceanFreight.tag, showImage: true },
  { title: ci.caseStudies.marketSnapshot.title, description: ci.caseStudies.marketSnapshot.description, href: lp('/ai-solutions/cases/market-snapshot'), tag: ci.caseStudies.marketSnapshot.tag, showImage: true },
  { title: ci.caseStudies.documentExtraction.title, description: ci.caseStudies.documentExtraction.description, href: lp('/ai-solutions/cases/document-extraction'), tag: ci.caseStudies.documentExtraction.tag, showImage: true },
];
---

<BaseLayout locale="zh-CN" title={ci.title} description={ci.description}>

  <!-- Hero -->
  <section class="relative overflow-hidden py-28 md:py-36 lg:py-44 px-6">
    <div class="absolute inset-0 -z-10 opacity-[0.07]" style="background: radial-gradient(ellipse 70% 50% at 60% 40%, #6B5CE7 0%, #4A7C59 100%);" aria-hidden="true"></div>
    <div class="max-w-[720px] mx-auto text-center">
      <nav class="text-sm text-luxon-muted mb-6" aria-label="Breadcrumb">
        <a href={lp('/ai-solutions')} class="hover:text-luxon-dark transition-colors">{t.nav.aiSolutions}</a>
        <span class="mx-2">/</span>
        <span>{ci.breadcrumb}</span>
      </nav>
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-luxon-dark tracking-tight leading-tight mb-6">{ci.heroTitle}</h1>
      <p class="text-lg md:text-xl text-luxon-muted max-w-[580px] mx-auto leading-relaxed">{ci.heroSubtitle}</p>
    </div>
  </section>

  <!-- Case Study Cards -->
  <div class="fade-in-up">
    <section class="px-6 pb-20 md:pb-28">
      <div class="max-w-[1100px] mx-auto">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {caseStudies.map((cs) => (
            <CaseStudyCard title={cs.title} description={cs.description} href={cs.href} tag={cs.tag} showImage={cs.showImage} />
          ))}
        </div>
      </div>
    </section>
  </div>

  <!-- CTA -->
  <div class="fade-in-up">
    <section class="px-6 py-20 md:py-28">
      <div class="max-w-[700px] mx-auto text-center">
        <div class="relative overflow-hidden rounded-2xl px-8 py-14 md:px-14 md:py-20" style="background: linear-gradient(135deg, #6B5CE7 0%, #4A7C59 100%);">
          <div class="absolute inset-0 opacity-[0.06]" style="background: radial-gradient(circle at 20% 80%, white 0%, transparent 50%), radial-gradient(circle at 80% 20%, white 0%, transparent 50%);" aria-hidden="true"></div>
          <div class="relative z-10">
            <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">{ci.ctaTitle}</h2>
            <p class="text-white/80 mb-10 text-lg leading-relaxed">{ci.ctaSubtitle}</p>
            <a href={lp('/contact')} class="inline-flex items-center px-8 py-3.5 bg-white text-luxon-dark font-semibold rounded-full text-lg hover:bg-gray-100 transition-colors">{t.aiSolutions.bookDiscovery}</a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <style>.fade-in-up{opacity:0;transform:translateY(1rem);transition:opacity .6s ease-out,transform .6s ease-out}.fade-in-up.is-visible{opacity:1;transform:translateY(0)}@media(prefers-reduced-motion:reduce){.fade-in-up{opacity:1;transform:none;transition:none}}</style>
  <script is:inline>
    (function () { var p = window.matchMedia('(prefers-reduced-motion: reduce)').matches; if (p) { document.querySelectorAll('.fade-in-up').forEach(function(e){e.classList.add('is-visible');}); return; } var o = new IntersectionObserver(function(e){e.forEach(function(n){if(n.isIntersecting){n.target.classList.add('is-visible');o.unobserve(n.target);}});},{threshold:0.1,rootMargin:'0px 0px -40px 0px'}); document.querySelectorAll('.fade-in-up').forEach(function(e){o.observe(e);}); })();
  </script>
</BaseLayout>
