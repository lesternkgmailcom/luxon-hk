---
/**
 * AI Workers Product Page — /ai-workers
 * 5 sections: Hero, Feature Cards, Comparison Table, Personas, CTA.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureCard from '../../components/ai-workers/FeatureCard.astro';
import ComparisonTable from '../../components/ai-workers/ComparisonTable.astro';
import PersonaCard from '../../components/ai-workers/PersonaCard.astro';

const features = [
  {
    title: 'Email Management',
    description: 'Reads, categorizes, and prioritizes your inbox. Drafts replies, follows up on threads, and ensures nothing slips through the cracks.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4A7C59" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 4L12 13L2 4"/></svg>`,
  },
  {
    title: 'Calendar & Scheduling',
    description: 'Books meetings, sends reminders, and manages conflicts across your team. Integrates with Google Calendar, Outlook, and more.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4A7C59" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
  },
  {
    title: 'WhatsApp & Messaging',
    description: 'Responds to customers on WhatsApp, captures leads, and answers frequently asked questions — around the clock.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4A7C59" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>`,
  },
  {
    title: 'Document Processing',
    description: 'Extracts structured data from PDFs, contracts, and invoices. Turns unstructured documents into actionable information.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4A7C59" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
  },
  {
    title: 'Daily Briefings',
    description: 'Summarizes what happened overnight and highlights priorities for the day. Starts your morning with clarity, not chaos.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4A7C59" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  },
  {
    title: 'Task Automation',
    description: 'Connects to your tools and executes multi-step workflows. Automates the repetitive so your team can focus on what matters.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4A7C59" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"/></svg>`,
  },
];

const personas = [
  {
    title: 'Startup Founders',
    description: 'You wear too many hats. Between sales, ops, and customer support, there is never enough time. An AI Worker takes the daily grind off your plate — email triage, scheduling, follow-ups — so you can focus on growth.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#6B5CE7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`,
  },
  {
    title: 'Operations Managers',
    description: 'Drowning in email, scheduling conflicts, and follow-up reminders that never stop. An AI Worker handles the operational noise — categorizing inbound, managing calendars, and keeping your team coordinated without manual effort.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#6B5CE7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/><line x1="12" y1="12" x2="12" y2="12.01"/></svg>`,
  },
  {
    title: 'Professional Services',
    description: 'Consultants, lawyers, and accountants spend hours on repetitive admin — invoicing, document formatting, client follow-ups. An AI Worker automates the paperwork so you can spend more time billing and less time busywork.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#6B5CE7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>`,
  },
];
---

<BaseLayout title="AI Workers — Your 24/7 AI Employee | Luxon" description="Deploy an autonomous AI Worker that handles email, scheduling, WhatsApp, and document processing. Live in 24 hours.">

  <!-- Section 1: Hero -->
  <section class="relative overflow-hidden py-28 md:py-36 lg:py-44 px-6">
    <div
      class="absolute inset-0 -z-10 opacity-[0.07]"
      style="background: radial-gradient(ellipse 70% 50% at 60% 40%, #4A7C59 0%, #6B5CE7 100%);"
      aria-hidden="true"
    ></div>
    <div
      class="absolute top-0 right-0 -z-10 w-[420px] h-[420px] rounded-full opacity-[0.04]"
      style="background: radial-gradient(circle, #6B5CE7 0%, transparent 70%);"
      aria-hidden="true"
    ></div>

    <div class="max-w-[720px] mx-auto text-center">
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-luxon-dark tracking-tight leading-tight mb-6">
        Your 24/7 AI Worker
      </h1>
      <p class="text-lg md:text-xl text-luxon-muted max-w-[580px] mx-auto leading-relaxed mb-10">
        An autonomous AI agent that handles email, scheduling, customer inquiries, and document processing — so your team can focus on what matters.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/ai-workers/pricing"
          class="inline-flex items-center px-8 py-3.5 bg-luxon-green text-white font-semibold rounded-full text-lg hover:bg-luxon-green-accent transition-colors"
        >
          View pricing
        </a>
        <a
          href="/contact"
          class="inline-flex items-center px-8 py-3.5 border border-luxon-border text-luxon-dark font-semibold rounded-full text-lg hover:bg-white transition-colors"
        >
          Talk to us
        </a>
      </div>
    </div>
  </section>

  <!-- Section 2: What Your AI Worker Can Do -->
  <div class="fade-in-up">
    <section class="px-6 py-20 md:py-28">
      <div class="max-w-[1100px] mx-auto">
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-luxon-dark text-center mb-4">
          What Your AI Worker Can Do
        </h2>
        <p class="text-luxon-muted text-center mb-12 max-w-[600px] mx-auto">
          Six core capabilities that run around the clock, integrated with the tools you already use.
        </p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map((feature) => (
            <FeatureCard
              title={feature.title}
              description={feature.description}
              icon={feature.icon}
            />
          ))}
        </div>
      </div>
    </section>
  </div>

  <!-- Section 3: Comparison Table -->
  <div class="fade-in-up">
    <ComparisonTable />
  </div>

  <!-- Section 4: Who Is This For? -->
  <div class="fade-in-up">
    <section class="px-6 py-20 md:py-28">
      <div class="max-w-[1100px] mx-auto">
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-luxon-dark text-center mb-4">
          Who Is This For?
        </h2>
        <p class="text-luxon-muted text-center mb-12 max-w-[600px] mx-auto">
          Built for teams and individuals who need more hours in the day.
        </p>
        <div class="grid md:grid-cols-3 gap-6">
          {personas.map((persona) => (
            <PersonaCard
              title={persona.title}
              description={persona.description}
              icon={persona.icon}
            />
          ))}
        </div>
      </div>
    </section>
  </div>

  <!-- Section 5: CTA -->
  <div class="fade-in-up">
    <section class="px-6 py-20 md:py-28">
      <div class="max-w-[700px] mx-auto text-center">
        <div
          class="relative overflow-hidden rounded-2xl px-8 py-14 md:px-14 md:py-20"
          style="background: linear-gradient(135deg, #4A7C59 0%, #3a6347 40%, #6B5CE7 100%);"
        >
          <div
            class="absolute inset-0 opacity-[0.06]"
            style="background: radial-gradient(circle at 20% 80%, white 0%, transparent 50%), radial-gradient(circle at 80% 20%, white 0%, transparent 50%);"
            aria-hidden="true"
          ></div>

          <div class="relative z-10">
            <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">
              Ready to deploy your AI Worker?
            </h2>
            <p class="text-white/80 mb-10 text-lg leading-relaxed">
              Most customers are live within 24 hours. See pricing or talk to us directly.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
              <a
                href="/ai-workers/pricing"
                class="inline-flex items-center px-8 py-3.5 bg-white text-luxon-dark font-semibold rounded-full text-lg hover:bg-gray-100 transition-colors"
              >
                View pricing
              </a>
              <a
                href="https://wa.me/85297381028"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2.5 px-8 py-3.5 border border-white/40 text-white font-semibold rounded-full text-lg hover:bg-white/10 transition-colors"
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                WhatsApp us
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Scroll animation: fade-in-up on viewport entry -->
  <style>
    .fade-in-up {
      opacity: 0;
      transform: translateY(1rem);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }

    .fade-in-up.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      .fade-in-up {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>

  <script is:inline>
    (function () {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) {
        document.querySelectorAll('.fade-in-up').forEach(function (el) {
          el.classList.add('is-visible');
        });
        return;
      }

      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.fade-in-up').forEach(function (el) {
        observer.observe(el);
      });
    })();
  </script>
</BaseLayout>
