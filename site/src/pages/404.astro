---
/**
 * 404 Page — Not Found
 * On-brand 404 with centered layout, subtle gradient accent, and CTA buttons.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page Not Found | Luxon" description="The page you're looking for doesn't exist or has moved.">

  <section class="relative flex items-center justify-center min-h-[70vh] px-6">
    <!-- Subtle gradient background -->
    <div
      class="absolute inset-0 -z-10 opacity-[0.04]"
      style="background: radial-gradient(ellipse 60% 50% at 50% 50%, #4A7C59 0%, #6B5CE7 100%);"
      aria-hidden="true"
    ></div>

    <div class="max-w-[600px] mx-auto text-center">
      <!-- Large 404 -->
      <h1 class="font-heading text-8xl md:text-9xl font-bold text-luxon-dark tracking-tight leading-none mb-6">
        404
      </h1>

      <!-- Message -->
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-luxon-dark mb-4">
        This page took a different route.
      </h2>

      <!-- Subtitle -->
      <p class="text-luxon-muted text-lg leading-relaxed mb-10 max-w-[480px] mx-auto">
        The page you're looking for doesn't exist or has moved.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center justify-center px-8 py-3.5 bg-luxon-green text-white font-semibold rounded-full text-lg hover:bg-luxon-green/90 transition-colors"
        >
          Back to home
        </a>
        <a
          href="/ai-solutions"
          class="inline-flex items-center justify-center px-8 py-3.5 bg-luxon-card border border-luxon-border text-luxon-dark font-semibold rounded-full text-lg hover:bg-luxon-border/50 transition-colors"
        >
          Explore AI Solutions
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
