---
/**
 * Case Study — Intelligent Document Extraction
 * /ai-solutions/cases/document-extraction
 *
 * Shorter secondary case study. Challenge → Solution → Scale → Results → CTA.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ScreenshotPlaceholder from '../../../components/ai-solutions/ScreenshotPlaceholder.astro';
---

<BaseLayout title="Case Study: Intelligent Document Extraction | Luxon" description="44 specialized extractors processing 100+ rate sheets per week across Excel, PDF, Word, email, and PNG — with zero manual data entry.">

  <!-- Hero -->
  <section class="relative overflow-hidden py-28 md:py-36 lg:py-44 px-6">
    <div
      class="absolute inset-0 -z-10 opacity-[0.07]"
      style="background: radial-gradient(ellipse 70% 50% at 60% 40%, #4A7C59 0%, #6B5CE7 100%);"
      aria-hidden="true"
    ></div>

    <div class="max-w-[720px] mx-auto text-center">
      <nav class="text-sm text-luxon-muted mb-6" aria-label="Breadcrumb">
        <a href="/ai-solutions" class="hover:text-luxon-dark transition-colors">AI Solutions</a>
        <span class="mx-2">/</span>
        <a href="/ai-solutions/cases" class="hover:text-luxon-dark transition-colors">Case Studies</a>
        <span class="mx-2">/</span>
        <span>Document Extraction</span>
      </nav>
      <p class="text-xs uppercase tracking-widest text-luxon-green-accent font-semibold mb-4">
        Case Study
      </p>
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-luxon-dark tracking-tight leading-tight mb-6">
        Intelligent Document Extraction
      </h1>
      <p class="text-lg md:text-xl text-luxon-muted max-w-[580px] mx-auto leading-relaxed">
        Extract structured data from any document format — even screenshots — with zero manual entry.
      </p>
    </div>
  </section>

  <!-- Results highlight -->
  <div class="fade-in-up">
    <section class="px-6 pb-20 md:pb-28">
      <div class="max-w-[900px] mx-auto">
        <div class="relative overflow-hidden rounded-xl bg-luxon-dark p-8 md:p-12">
          <div
            class="absolute -top-20 -right-20 w-60 h-60 rounded-full opacity-10"
            style="background: radial-gradient(circle, #6B5CE7 0%, transparent 70%);"
            aria-hidden="true"
          ></div>
          <div class="relative z-10 grid grid-cols-2 sm:grid-cols-4 gap-6">
            <div>
              <p class="font-heading text-3xl md:text-4xl font-bold text-luxon-green-accent mb-1">44</p>
              <p class="text-sm text-gray-400">extractor modules</p>
            </div>
            <div>
              <p class="font-heading text-3xl md:text-4xl font-bold text-white mb-1">13</p>
              <p class="text-sm text-gray-400">carriers covered</p>
            </div>
            <div>
              <p class="font-heading text-3xl md:text-4xl font-bold text-white mb-1">6+</p>
              <p class="text-sm text-gray-400">input formats</p>
            </div>
            <div>
              <p class="font-heading text-3xl md:text-4xl font-bold text-luxon-green-accent mb-1">Zero</p>
              <p class="text-sm text-gray-400">manual data entry</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Challenge -->
  <div class="fade-in-up">
    <section class="px-6 py-20 md:py-28">
      <div class="max-w-[800px] mx-auto">
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-luxon-dark mb-8">
          The Challenge
        </h2>
        <div class="space-y-5 text-luxon-text leading-relaxed">
          <p>
            Carrier rate sheets arrive in <strong>6+ formats</strong>: Excel (.xls and .xlsx), PDF, Word (.docx), Outlook .msg, RFC822 email with inline text, and even PNG screenshots of rate tables embedded in email bodies.
          </p>
          <p>
            Each of 13 carriers uses a different layout — some change it between filings. A single misread cell can mean quoting the wrong rate to a customer. Manual data entry is slow, error-prone, and does not scale.
          </p>
        </div>
      </div>
    </section>
  </div>

  <!-- Solution -->
  <div class="fade-in-up">
    <section class="px-6 py-20 md:py-28 bg-white">
      <div class="max-w-[800px] mx-auto">
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-luxon-dark mb-8">
          The Solution
        </h2>
        <div class="space-y-6">
          <div class="flex gap-4">
            <div class="w-8 h-8 rounded-lg bg-luxon-green/10 flex items-center justify-center shrink-0 mt-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4A7C59" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div>
              <h3 class="font-heading text-lg font-bold text-luxon-dark mb-1">Intelligent email routing</h3>
              <p class="text-luxon-muted leading-relaxed">
                24+ subject regex patterns, 14 trade patterns, 13 sender domain patterns, plus content-based validation. Files auto-renamed to standardized carrier-trade-date format.
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-8 h-8 rounded-lg bg-luxon-green/10 flex items-center justify-center shrink-0 mt-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4A7C59" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
              </svg>
            </div>
            <div>
              <h3 class="font-heading text-lg font-bold text-luxon-dark mb-1">44 carrier-specific extractors</h3>
              <p class="text-luxon-muted leading-relaxed">
                Each tailored to one carrier's format for one trade lane. Handles merged cells, multi-sheet workbooks, dynamic sheet names, semicolon-separated LOCODEs, ordinal-day validity formats, and more.
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-8 h-8 rounded-lg bg-luxon-green/10 flex items-center justify-center shrink-0 mt-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4A7C59" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 16 12 12 8 16"/>
                <line x1="12" y1="12" x2="12" y2="21"/>
                <path d="M20.39 18.39A5 5 0 0018 9h-1.26A8 8 0 103 16.3"/>
              </svg>
            </div>
            <div>
              <h3 class="font-heading text-lg font-bold text-luxon-dark mb-1">Vision AI for screenshots</h3>
              <p class="text-luxon-muted leading-relaxed">
                Uses multimodal AI (glm-4.6v) to OCR PNG rate table screenshots from carriers that embed images instead of attaching files.
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-8 h-8 rounded-lg bg-luxon-green/10 flex items-center justify-center shrink-0 mt-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4A7C59" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-heading text-lg font-bold text-luxon-dark mb-1">Self-healing pipeline</h3>
              <p class="text-luxon-muted leading-relaxed">
                Format-mismatch guards, import-level error containment (one crashing file never blocks the batch), seen-recovery for crashed polls, and SHA-256 deduplication.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Scale -->
  <div class="fade-in-up">
    <section class="px-6 py-20 md:py-28">
      <div class="max-w-[900px] mx-auto">
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-luxon-dark text-center mb-12">
          Scale at a Glance
        </h2>
        <!-- TODO: Replace with actual extraction pipeline diagram or screenshots -->
        <ScreenshotPlaceholder label="Extraction pipeline flow \u2014 Email \u2192 Detection \u2192 Format Routing \u2192 Carrier Extractor \u2192 Database" aspect="aspect-[16/10]" />
      </div>
    </section>
  </div>

  <!-- CTA -->
  <div class="fade-in-up">
    <section class="px-6 py-20 md:py-28">
      <div class="max-w-[700px] mx-auto text-center">
        <div
          class="relative overflow-hidden rounded-2xl px-8 py-14 md:px-14 md:py-20"
          style="background: linear-gradient(135deg, #4A7C59 0%, #3a6347 40%, #6B5CE7 100%);"
        >
          <div
            class="absolute inset-0 opacity-[0.06]"
            style="background: radial-gradient(circle at 20% 80%, white 0%, transparent 50%), radial-gradient(circle at 80% 20%, white 0%, transparent 50%);"
            aria-hidden="true"
          ></div>

          <div class="relative z-10">
            <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">
              Processing documents manually?
            </h2>
            <p class="text-white/80 mb-10 text-lg leading-relaxed">
              We build extraction engines that read any format, at scale, with zero manual entry.
            </p>
            <a
              href="/contact"
              class="inline-flex items-center px-8 py-3.5 bg-white text-luxon-dark font-semibold rounded-full text-lg hover:bg-gray-100 transition-colors"
            >
              Book a Discovery Call
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Scroll animation -->
  <style>
    .fade-in-up {
      opacity: 0;
      transform: translateY(1rem);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }

    .fade-in-up.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      .fade-in-up {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>

  <script is:inline>
    (function () {
      var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) {
        document.querySelectorAll('.fade-in-up').forEach(function (el) {
          el.classList.add('is-visible');
        });
        return;
      }

      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.fade-in-up').forEach(function (el) {
        observer.observe(el);
      });
    })();
  </script>
</BaseLayout>
