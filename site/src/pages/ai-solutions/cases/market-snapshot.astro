---
/**
 * Case Study — Daily Market Snapshot
 * /ai-solutions/cases/market-snapshot
 *
 * Shorter secondary case study. Challenge → Solution → Results → CTA.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Case Study: Daily Market Snapshot | Luxon" description="From 2 hours of manual spreadsheet compilation to a 30-second automated pipeline that generates and emails daily market reports.">

  <!-- Hero -->
  <section class="relative overflow-hidden py-28 md:py-36 lg:py-44 px-6">
    <div
      class="absolute inset-0 -z-10 opacity-[0.07]"
      style="background: radial-gradient(ellipse 70% 50% at 60% 40%, #4A7C59 0%, #6B5CE7 100%);"
      aria-hidden="true"
    ></div>

    <div class="max-w-[720px] mx-auto text-center">
      <nav class="text-sm text-luxon-muted mb-6" aria-label="Breadcrumb">
        <a href="/ai-solutions" class="hover:text-luxon-dark transition-colors">AI Solutions</a>
        <span class="mx-2">/</span>
        <a href="/ai-solutions/cases" class="hover:text-luxon-dark transition-colors">Case Studies</a>
        <span class="mx-2">/</span>
        <span>Daily Market Snapshot</span>
      </nav>
      <p class="text-xs uppercase tracking-widest text-luxon-green-accent font-semibold mb-4">
        Case Study
      </p>
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-luxon-dark tracking-tight leading-tight mb-6">
        Daily Market Snapshot
      </h1>
      <p class="text-lg md:text-xl text-luxon-muted max-w-[580px] mx-auto leading-relaxed">
        From 2 hours of manual spreadsheet compilation to an automated pipeline that delivers market intelligence to your inbox every morning.
      </p>
    </div>
  </section>

  <!-- Results highlight -->
  <div class="fade-in-up">
    <section class="px-6 pb-20 md:pb-28">
      <div class="max-w-[900px] mx-auto">
        <div class="relative overflow-hidden rounded-xl bg-luxon-dark p-8 md:p-12">
          <div
            class="absolute -top-20 -right-20 w-60 h-60 rounded-full opacity-10"
            style="background: radial-gradient(circle, #6B5CE7 0%, transparent 70%);"
            aria-hidden="true"
          ></div>
          <div class="relative z-10 grid sm:grid-cols-3 gap-6 md:gap-8">
            <div>
              <p class="font-heading text-3xl md:text-4xl font-bold text-luxon-green-accent mb-1">30 sec</p>
              <p class="text-sm text-gray-400">report generation (was 2+ hours)</p>
            </div>
            <div>
              <p class="font-heading text-3xl md:text-4xl font-bold text-white mb-1">5 lanes</p>
              <p class="text-sm text-gray-400">trade lanes covered daily</p>
            </div>
            <div>
              <p class="font-heading text-3xl md:text-4xl font-bold text-white mb-1">6 PM</p>
              <p class="text-sm text-gray-400">auto-emailed weekdays</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Challenge -->
  <div class="fade-in-up">
    <section class="px-6 py-20 md:py-28">
      <div class="max-w-[800px] mx-auto">
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-luxon-dark mb-8">
          The Challenge
        </h2>
        <div class="space-y-5 text-luxon-text leading-relaxed">
          <p>
            Regional management needs daily and weekly market rate summaries to make procurement decisions. But manually compiling rates from 13 carriers across 5 trade lanes took <strong>2+ hours every day</strong>.
          </p>
          <p>
            Different data sources — auto-extracted from databases plus manually entered from carriers without extractors — must be combined into a single coherent report. Coverage gaps, missing carriers, and stale data all had to be tracked manually.
          </p>
        </div>
      </div>
    </section>
  </div>

  <!-- Solution -->
  <div class="fade-in-up">
    <section class="px-6 py-20 md:py-28 bg-white">
      <div class="max-w-[800px] mx-auto">
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-luxon-dark mb-8">
          The Solution
        </h2>
        <div class="space-y-6">
          <div class="flex gap-4">
            <div class="w-8 h-8 rounded-lg bg-luxon-green/10 flex items-center justify-center shrink-0 mt-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4A7C59" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div>
              <h3 class="font-heading text-lg font-bold text-luxon-dark mb-1">Automated daily snapshot</h3>
              <p class="text-luxon-muted leading-relaxed">
                Pipeline pulls rates from SQLite databases and manual carrier config, validates coverage per trade lane (11 carriers for TPEB, 10 for WCSA, etc.), generates a formatted Excel report with 5 stacked trade sections, and auto-emails at 6 PM weekdays.
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-8 h-8 rounded-lg bg-luxon-green/10 flex items-center justify-center shrink-0 mt-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4A7C59" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"/>
              </svg>
            </div>
            <div>
              <h3 class="font-heading text-lg font-bold text-luxon-dark mb-1">Smart coverage and validity logic</h3>
              <p class="text-luxon-muted leading-relaxed">
                Forward-looking validity using today + 7 days. Per-carrier query patterns for complex routing. Backfill from direct DB queries when the snapshot drops a carrier.
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-8 h-8 rounded-lg bg-luxon-green/10 flex items-center justify-center shrink-0 mt-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4A7C59" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
              </svg>
            </div>
            <div>
              <h3 class="font-heading text-lg font-bold text-luxon-dark mb-1">Weekly executive report with AI review</h3>
              <p class="text-luxon-muted leading-relaxed">
                AI composes an HTML email with rate tables, per-trade WoW analysis, regional narratives, and management-level commentary. A second AI agent reviews for content consistency, data accuracy, and tone before sending.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Screenshot placeholder -->
  <div class="fade-in-up">
    <section class="px-6 py-20 md:py-28">
      <div class="max-w-[900px] mx-auto">
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-luxon-dark text-center mb-12">
          Snapshot Report
        </h2>
        <img
          src="/images/case-studies/ocean-freight-dashboard-full.png"
          alt="Daily market snapshot report showing formatted rate tables across five trade sections"
          class="w-full rounded-xl border border-luxon-border shadow-sm"
          loading="lazy"
        />
      </div>
    </section>
  </div>

  <!-- CTA -->
  <div class="fade-in-up">
    <section class="px-6 py-20 md:py-28">
      <div class="max-w-[700px] mx-auto text-center">
        <div
          class="relative overflow-hidden rounded-2xl px-8 py-14 md:px-14 md:py-20"
          style="background: linear-gradient(135deg, #4A7C59 0%, #3a6347 40%, #6B5CE7 100%);"
        >
          <div
            class="absolute inset-0 opacity-[0.06]"
            style="background: radial-gradient(circle at 20% 80%, white 0%, transparent 50%), radial-gradient(circle at 80% 20%, white 0%, transparent 50%);"
            aria-hidden="true"
          ></div>

          <div class="relative z-10">
            <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">
              Need automated reporting?
            </h2>
            <p class="text-white/80 mb-10 text-lg leading-relaxed">
              We build custom reporting pipelines that deliver the data you need, when you need it.
            </p>
            <a
              href="/contact"
              class="inline-flex items-center px-8 py-3.5 bg-white text-luxon-dark font-semibold rounded-full text-lg hover:bg-gray-100 transition-colors"
            >
              Book a Discovery Call
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Scroll animation -->
  <style>
    .fade-in-up {
      opacity: 0;
      transform: translateY(1rem);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }

    .fade-in-up.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      .fade-in-up {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>

  <script is:inline>
    (function () {
      var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) {
        document.querySelectorAll('.fade-in-up').forEach(function (el) {
          el.classList.add('is-visible');
        });
        return;
      }

      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.fade-in-up').forEach(function (el) {
        observer.observe(el);
      });
    })();
  </script>
</BaseLayout>
