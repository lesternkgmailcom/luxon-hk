---
/**
 * AI Solutions Product Page — /ai-solutions
 * 5 sections: Hero, What We Build, Who This Is For, Case Study Teasers, CTA.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SolutionCard from '../../components/ai-solutions/SolutionCard.astro';
import CaseStudyCard from '../../components/ai-solutions/CaseStudyCard.astro';

const solutions = [
  {
    title: 'Rate Intelligence Dashboards',
    description: 'Automated data extraction, comparison views, and trend analysis. Track rates across carriers, trade lanes, and time — in one place.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4A7C59" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/><path d="M2 20h20"/></svg>`,
  },
  {
    title: 'Reporting Automation',
    description: 'Daily or weekly automated reports pulled from spreadsheets, databases, and APIs. Formatted and delivered to your inbox on schedule.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4A7C59" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  },
  {
    title: 'Workflow Dashboards',
    description: 'Centralized views of your operations data with real-time monitoring. See what is happening across your business at a glance.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4A7C59" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>`,
  },
  {
    title: 'Document Processing Pipelines',
    description: 'Extract structured data from unstructured documents — PDFs, emails, images, spreadsheets — with zero manual entry.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4A7C59" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0018 9h-1.26A8 8 0 103 16.3"/></svg>`,
  },
];

const industries = [
  {
    label: 'Logistics & Freight',
    primary: true,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>`,
  },
  {
    label: 'Trading & Procurement',
    primary: false,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7l5-3 5 3 5-3 5 3v13l-5 3-5-3-5 3-5-3z"/><path d="M7 4v13"/><path d="M17 4v13"/><path d="M2 7h20"/></svg>`,
  },
  {
    label: 'Finance & Accounting',
    primary: false,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>`,
  },
  {
    label: 'Any business with repetitive data workflows',
    primary: false,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>`,
  },
];
---

<BaseLayout title="AI Solutions — Custom Dashboards & Automation | Luxon" description="Custom AI dashboards, automation pipelines, and data tools designed around the way your team actually works.">

  <!-- Section 1: Hero -->
  <section class="relative overflow-hidden py-28 md:py-36 lg:py-44 px-6">
    <div
      class="absolute inset-0 -z-10 opacity-[0.07]"
      style="background: radial-gradient(ellipse 70% 50% at 60% 40%, #6B5CE7 0%, #4A7C59 100%);"
      aria-hidden="true"
    ></div>
    <div
      class="absolute top-0 right-0 -z-10 w-[420px] h-[420px] rounded-full opacity-[0.04]"
      style="background: radial-gradient(circle, #4A7C59 0%, transparent 70%);"
      aria-hidden="true"
    ></div>

    <div class="max-w-[720px] mx-auto text-center">
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-luxon-dark tracking-tight leading-tight mb-6">
        AI Solutions Built for Your Business
      </h1>
      <p class="text-lg md:text-xl text-luxon-muted max-w-[580px] mx-auto leading-relaxed mb-10">
        Custom dashboards, automation pipelines, and data tools — designed around the way your team actually works.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/contact"
          class="inline-flex items-center px-8 py-3.5 bg-luxon-green text-white font-semibold rounded-full text-lg hover:bg-luxon-green-accent transition-colors"
        >
          Book a Discovery Call
        </a>
        <a
          href="/ai-solutions/cases"
          class="inline-flex items-center px-8 py-3.5 border border-luxon-border text-luxon-dark font-semibold rounded-full text-lg hover:bg-white transition-colors"
        >
          See case studies
        </a>
      </div>
    </div>
  </section>

  <!-- Section 2: What We Build -->
  <div class="fade-in-up">
    <section class="px-6 py-20 md:py-28">
      <div class="max-w-[1100px] mx-auto">
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-luxon-dark text-center mb-4">
          What We Build
        </h2>
        <p class="text-luxon-muted text-center mb-12 max-w-[600px] mx-auto">
          Four types of AI-powered solutions, each tailored to your data and workflow.
        </p>
        <div class="grid sm:grid-cols-2 gap-6">
          {solutions.map((solution) => (
            <SolutionCard
              title={solution.title}
              description={solution.description}
              icon={solution.icon}
            />
          ))}
        </div>
      </div>
    </section>
  </div>

  <!-- Section 3: Who This Is For -->
  <div class="fade-in-up">
    <section class="px-6 py-20 md:py-28">
      <div class="max-w-[1100px] mx-auto">
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-luxon-dark text-center mb-4">
          Who This Is For
        </h2>
        <p class="text-luxon-muted text-center mb-12 max-w-[600px] mx-auto">
          We work with teams that deal with complex data, repetitive processes, and manual reporting.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          {industries.map((industry) => (
            <div
              class={`inline-flex items-center gap-2.5 px-5 py-3 rounded-full border transition-colors ${
                industry.primary
                  ? 'bg-luxon-green/10 border-luxon-green/30 text-luxon-green font-semibold'
                  : 'bg-luxon-card border-luxon-border text-luxon-text'
              }`}
            >
              <Fragment set:html={industry.icon} />
              <span class="text-sm">{industry.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>

  <!-- Section 4: Case Study Teasers -->
  <div class="fade-in-up">
    <section class="px-6 py-20 md:py-28">
      <div class="max-w-[1100px] mx-auto">
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-luxon-dark text-center mb-4">
          See What We Have Built
        </h2>
        <p class="text-luxon-muted text-center mb-12 max-w-[600px] mx-auto">
          Real solutions delivering real results. Read the full stories.
        </p>
        <div class="grid md:grid-cols-3 gap-6">
          <CaseStudyCard
            title="Ocean Freight Rate Intelligence"
            description="AI-powered dashboard automating rate tracking across 13 carriers and 5 trade lanes."
            href="/ai-solutions/cases/ocean-freight-dashboard"
            tag="Logistics"
            showImage={true}
          />
          <CaseStudyCard
            title="Daily Market Snapshot"
            description="Automated pipeline generating and emailing daily market reports — in 30 seconds instead of 2 hours."
            href="/ai-solutions/cases/market-snapshot"
            tag="Reporting"
            showImage={true}
          />
          <CaseStudyCard
            title="Intelligent Document Extraction"
            description="44 specialized extractors processing 100+ rate sheets per week across 6 formats with zero manual entry."
            href="/ai-solutions/cases/document-extraction"
            tag="Processing"
            showImage={true}
          />
        </div>
      </div>
    </section>
  </div>

  <!-- Section 5: Process link + CTA -->
  <div class="fade-in-up">
    <section class="px-6 py-20 md:py-28">
      <div class="max-w-[700px] mx-auto text-center">
        <div
          class="relative overflow-hidden rounded-2xl px-8 py-14 md:px-14 md:py-20"
          style="background: linear-gradient(135deg, #6B5CE7 0%, #4A7C59 100%);"
        >
          <div
            class="absolute inset-0 opacity-[0.06]"
            style="background: radial-gradient(circle at 20% 80%, white 0%, transparent 50%), radial-gradient(circle at 80% 20%, white 0%, transparent 50%);"
            aria-hidden="true"
          ></div>

          <div class="relative z-10">
            <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">
              Ready to automate your workflow?
            </h2>
            <p class="text-white/80 mb-8 text-lg leading-relaxed">
              We build custom AI solutions in as little as 4 weeks. See how our process works, or book a discovery call.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
              <a
                href="/contact"
                class="inline-flex items-center px-8 py-3.5 bg-white text-luxon-dark font-semibold rounded-full text-lg hover:bg-gray-100 transition-colors"
              >
                Book a Discovery Call
              </a>
              <a
                href="/ai-solutions/process"
                class="inline-flex items-center gap-2 px-8 py-3.5 border border-white/40 text-white font-semibold rounded-full text-lg hover:bg-white/10 transition-colors"
              >
                See our process
                <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 8h10M9 4l4 4-4 4"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Scroll animation: fade-in-up on viewport entry -->
  <style>
    .fade-in-up {
      opacity: 0;
      transform: translateY(1rem);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }

    .fade-in-up.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      .fade-in-up {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>

  <script is:inline>
    (function () {
      var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) {
        document.querySelectorAll('.fade-in-up').forEach(function (el) {
          el.classList.add('is-visible');
        });
        return;
      }

      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.fade-in-up').forEach(function (el) {
        observer.observe(el);
      });
    })();
  </script>
</BaseLayout>
