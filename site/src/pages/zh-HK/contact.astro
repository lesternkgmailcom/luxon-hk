---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n/utils';

const t = getTranslations('zh-HK');
const ct = t.contact;
---

<BaseLayout locale="zh-HK" title={ct.title} description={ct.description}>
  <section class="relative overflow-hidden py-20 md:py-28 px-6">
    <div class="absolute inset-0 -z-10 opacity-[0.05]" style="background: radial-gradient(ellipse 70% 50% at 60% 40%, #4A7C59 0%, #6B5CE7 100%);" aria-hidden="true"></div>
    <div class="max-w-[720px] mx-auto text-center">
      <h1 class="font-heading text-4xl md:text-5xl font-bold text-luxon-dark tracking-tight leading-tight mb-4">{ct.heroTitle}</h1>
      <p class="text-lg text-luxon-muted max-w-[580px] mx-auto leading-relaxed">{ct.heroSubtitle}</p>
    </div>
  </section>

  <div class="fade-in-up">
    <section class="px-6 pb-20 md:pb-28">
      <div class="max-w-[1100px] mx-auto grid lg:grid-cols-5 gap-12 lg:gap-16 items-start">
        <div class="lg:col-span-3">
          <form id="contact-form" class="space-y-5">
            <div>
              <label for="name" class="block text-sm font-medium text-luxon-text mb-1.5">{ct.formName}</label>
              <input type="text" id="name" name="name" required placeholder={ct.formNamePlaceholder} class="w-full bg-luxon-card border border-luxon-border rounded-lg px-4 py-3 text-luxon-text placeholder:text-luxon-muted/60 focus:outline-none focus:ring-2 focus:ring-luxon-green focus:border-transparent transition-shadow" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-luxon-text mb-1.5">{ct.formEmail}</label>
              <input type="email" id="email" name="email" required placeholder="you@company.com" class="w-full bg-luxon-card border border-luxon-border rounded-lg px-4 py-3 text-luxon-text placeholder:text-luxon-muted/60 focus:outline-none focus:ring-2 focus:ring-luxon-green focus:border-transparent transition-shadow" />
            </div>
            <div>
              <label for="company" class="block text-sm font-medium text-luxon-text mb-1.5">{ct.formCompany} <span class="text-luxon-muted font-normal">{ct.formCompanyOptional}</span></label>
              <input type="text" id="company" name="company" placeholder={ct.formCompanyPlaceholder} class="w-full bg-luxon-card border border-luxon-border rounded-lg px-4 py-3 text-luxon-text placeholder:text-luxon-muted/60 focus:outline-none focus:ring-2 focus:ring-luxon-green focus:border-transparent transition-shadow" />
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-luxon-text mb-1.5">{ct.formMessage}</label>
              <textarea id="message" name="message" required rows="5" placeholder={ct.formMessagePlaceholder} class="w-full bg-luxon-card border border-luxon-border rounded-lg px-4 py-3 text-luxon-text placeholder:text-luxon-muted/60 focus:outline-none focus:ring-2 focus:ring-luxon-green focus:border-transparent transition-shadow resize-y"></textarea>
            </div>
            <button type="submit" class="inline-flex items-center justify-center w-full sm:w-auto px-8 py-3.5 bg-luxon-green text-white font-semibold rounded-full text-lg hover:bg-luxon-green/90 transition-colors cursor-pointer">{ct.formSubmit}</button>
          </form>
        </div>
        <div class="lg:col-span-2">
          <div class="space-y-8">
            <div class="bg-luxon-card rounded-xl border border-luxon-border p-6 shadow-sm">
              <h2 class="font-heading font-bold text-luxon-dark mb-5 text-lg">{ct.otherWaysTitle}</h2>
              <div class="space-y-4">
                <div class="flex items-start gap-3">
                  <div class="w-10 h-10 rounded-lg bg-luxon-green/10 flex items-center justify-center shrink-0 mt-0.5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4A7C59" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-luxon-text">{ct.formEmail}</p>
                    <a href="mailto:info@luxon.hk" class="text-luxon-green hover:underline">info@luxon.hk</a>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <div class="w-10 h-10 rounded-lg bg-luxon-green/10 flex items-center justify-center shrink-0 mt-0.5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4A7C59" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-luxon-text">Location</p>
                    <p class="text-luxon-muted text-sm">{ct.location}</p>
                  </div>
                </div>
              </div>
            </div>
            <div class="bg-luxon-card rounded-xl border border-luxon-border p-6 shadow-sm">
              <h2 class="font-heading font-bold text-luxon-dark mb-2 text-lg">{ct.preferMessageTitle}</h2>
              <p class="text-luxon-muted text-sm mb-5">{ct.preferMessageSubtitle}</p>
              <a href="https://wa.me/85297381028" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 px-6 py-3 bg-[#25D366] text-white font-semibold rounded-full text-base hover:bg-[#20BD5A] transition-colors">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                {ct.whatsappUs}
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <style>.fade-in-up{opacity:0;transform:translateY(1rem);transition:opacity .6s ease-out,transform .6s ease-out}.fade-in-up.is-visible{opacity:1;transform:translateY(0)}@media(prefers-reduced-motion:reduce){.fade-in-up{opacity:1;transform:none;transition:none}}</style>
  <script is:inline>
    (function () {
      var p = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (p) { document.querySelectorAll('.fade-in-up').forEach(function(e){e.classList.add('is-visible');}); }
      else { var o = new IntersectionObserver(function(e){e.forEach(function(n){if(n.isIntersecting){n.target.classList.add('is-visible');o.unobserve(n.target);}});},{threshold:0.1,rootMargin:'0px 0px -40px 0px'}); document.querySelectorAll('.fade-in-up').forEach(function(e){o.observe(e);}); }
      var form = document.getElementById('contact-form');
      if (form) { form.addEventListener('submit', function(e) { e.preventDefault(); var n=form.querySelector('[name="name"]').value.trim(),em=form.querySelector('[name="email"]').value.trim(),c=form.querySelector('[name="company"]').value.trim(),m=form.querySelector('[name="message"]').value.trim(); var s='Luxon Contact: '+n+(c?' ('+c+')':''),b='Name: '+n+'\nEmail: '+em+'\n'+(c?'Company: '+c+'\n':'')+'\nProject:\n'+m; window.location.href='mailto:info@luxon.hk?subject='+encodeURIComponent(s)+'&body='+encodeURIComponent(b); }); }
    })();
  </script>
</BaseLayout>
