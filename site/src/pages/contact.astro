---
/**
 * Contact Page — /contact
 * Dedicated contact point for AI Solutions inquiries (project-based pricing).
 * Form uses client-side mailto handler; backend Cloudflare Function to be wired later.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact Us — Get in Touch | Luxon" description="Tell us about your project. Whether you need an AI Worker or a custom solution, we'll help you find the right approach.">

  <!-- Hero -->
  <section class="relative overflow-hidden py-20 md:py-28 px-6">
    <div
      class="absolute inset-0 -z-10 opacity-[0.05]"
      style="background: radial-gradient(ellipse 70% 50% at 60% 40%, #4A7C59 0%, #6B5CE7 100%);"
      aria-hidden="true"
    ></div>

    <div class="max-w-[720px] mx-auto text-center">
      <h1 class="font-heading text-4xl md:text-5xl font-bold text-luxon-dark tracking-tight leading-tight mb-4">
        Let's talk
      </h1>
      <p class="text-lg text-luxon-muted max-w-[580px] mx-auto leading-relaxed">
        Tell us about your project. Whether you need an AI Worker or a custom solution, we'll help you find the right approach.
      </p>
    </div>
  </section>

  <!-- Contact Form + Info -->
  <div class="fade-in-up">
    <section class="px-6 pb-20 md:pb-28">
      <div class="max-w-[1100px] mx-auto grid lg:grid-cols-5 gap-12 lg:gap-16 items-start">

        <!-- Left Column: Form -->
        <div class="lg:col-span-3">
          <!-- TODO: Wire to Cloudflare Function for server-side email delivery -->
          <form id="contact-form" class="space-y-5">
            <!-- Name -->
            <div>
              <label for="name" class="block text-sm font-medium text-luxon-text mb-1.5">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Your name"
                class="w-full bg-luxon-card border border-luxon-border rounded-lg px-4 py-3 text-luxon-text placeholder:text-luxon-muted/60 focus:outline-none focus:ring-2 focus:ring-luxon-green focus:border-transparent transition-shadow"
              />
            </div>

            <!-- Email -->
            <div>
              <label for="email" class="block text-sm font-medium text-luxon-text mb-1.5">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="you@company.com"
                class="w-full bg-luxon-card border border-luxon-border rounded-lg px-4 py-3 text-luxon-text placeholder:text-luxon-muted/60 focus:outline-none focus:ring-2 focus:ring-luxon-green focus:border-transparent transition-shadow"
              />
            </div>

            <!-- Company (optional) -->
            <div>
              <label for="company" class="block text-sm font-medium text-luxon-text mb-1.5">Company <span class="text-luxon-muted font-normal">(optional)</span></label>
              <input
                type="text"
                id="company"
                name="company"
                placeholder="Your company name"
                class="w-full bg-luxon-card border border-luxon-border rounded-lg px-4 py-3 text-luxon-text placeholder:text-luxon-muted/60 focus:outline-none focus:ring-2 focus:ring-luxon-green focus:border-transparent transition-shadow"
              />
            </div>

            <!-- Project description -->
            <div>
              <label for="message" class="block text-sm font-medium text-luxon-text mb-1.5">Tell us about your project</label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                placeholder="Describe what you're looking for — e.g. automation challenges, data workflows, AI agents you need..."
                class="w-full bg-luxon-card border border-luxon-border rounded-lg px-4 py-3 text-luxon-text placeholder:text-luxon-muted/60 focus:outline-none focus:ring-2 focus:ring-luxon-green focus:border-transparent transition-shadow resize-y"
              ></textarea>
            </div>

            <!-- Submit -->
            <button
              type="submit"
              class="inline-flex items-center justify-center w-full sm:w-auto px-8 py-3.5 bg-luxon-green text-white font-semibold rounded-full text-lg hover:bg-luxon-green/90 transition-colors cursor-pointer"
            >
              Send message
            </button>
          </form>
        </div>

        <!-- Right Column: Contact Info + WhatsApp -->
        <div class="lg:col-span-2">
          <div class="space-y-8">

            <!-- Direct contact info -->
            <div class="bg-luxon-card rounded-xl border border-luxon-border p-6 shadow-sm">
              <h2 class="font-heading font-bold text-luxon-dark mb-5 text-lg">Other ways to reach us</h2>

              <div class="space-y-4">
                <!-- Email -->
                <div class="flex items-start gap-3">
                  <div class="w-10 h-10 rounded-lg bg-luxon-green/10 flex items-center justify-center shrink-0 mt-0.5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4A7C59" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-luxon-text">Email</p>
                    <a href="mailto:info@luxon.hk" class="text-luxon-green hover:underline">info@luxon.hk</a>
                  </div>
                </div>

                <!-- Location -->
                <div class="flex items-start gap-3">
                  <div class="w-10 h-10 rounded-lg bg-luxon-green/10 flex items-center justify-center shrink-0 mt-0.5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4A7C59" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-luxon-text">Location</p>
                    <p class="text-luxon-muted text-sm">Hong Kong (serving Asia Pacific)</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- WhatsApp CTA -->
            <div class="bg-luxon-card rounded-xl border border-luxon-border p-6 shadow-sm">
              <h2 class="font-heading font-bold text-luxon-dark mb-2 text-lg">Prefer to message?</h2>
              <p class="text-luxon-muted text-sm mb-5">WhatsApp us directly. We typically respond within a few hours.</p>

              <a
                href="https://wa.me/85297381028"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2.5 px-6 py-3 bg-[#25D366] text-white font-semibold rounded-full text-base hover:bg-[#20BD5A] transition-colors"
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                WhatsApp us
              </a>
            </div>

          </div>
        </div>

      </div>
    </section>
  </div>

  <!-- Scroll animation -->
  <style>
    .fade-in-up {
      opacity: 0;
      transform: translateY(1rem);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }

    .fade-in-up.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      .fade-in-up {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>

  <!-- Client-side form handler: constructs mailto link with form data -->
  <script is:inline>
    (function () {
      // Fade-in-up observer
      var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) {
        document.querySelectorAll('.fade-in-up').forEach(function (el) {
          el.classList.add('is-visible');
        });
      } else {
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.fade-in-up').forEach(function (el) {
          observer.observe(el);
        });
      }

      // Contact form: mailto handler
      var form = document.getElementById('contact-form');
      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();

          var name = form.querySelector('[name="name"]').value.trim();
          var email = form.querySelector('[name="email"]').value.trim();
          var company = form.querySelector('[name="company"]').value.trim();
          var message = form.querySelector('[name="message"]').value.trim();

          var subject = 'Luxon Contact: ' + name + (company ? ' (' + company + ')' : '');
          var body = 'Name: ' + name + '\n'
            + 'Email: ' + email + '\n'
            + (company ? 'Company: ' + company + '\n' : '')
            + '\nProject:\n' + message;

          var mailto = 'mailto:info@luxon.hk'
            + '?subject=' + encodeURIComponent(subject)
            + '&body=' + encodeURIComponent(body);

          window.location.href = mailto;
        });
      }
    })();
  </script>
</BaseLayout>
