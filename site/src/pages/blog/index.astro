---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Blog — Luxon HK" description="Real use cases of AI assistants in Hong Kong — contract signing, class booking, and more. See how people actually use AI to save time every day.">
  <Fragment slot="head">
    <link rel="stylesheet" href="/legacy-shared.css" />
    <link rel="stylesheet" href="/blog/styles.css" />
  </Fragment>

  <!-- Blog Hero -->
  <section class="blog-hero">
    <div class="container">
      <h1>Use Cases</h1>
      <p>Real stories of how AI assistants save time every day. No hype — just what actually works.</p>
    </div>
  </section>

  <!-- Blog Listing -->
  <section class="blog-listing">
    <div class="container">
      <div class="blog-grid">

        <!-- Post 1: Contract Signing -->
        <a href="/blog/ai-contract-signing" class="blog-card fade-in-up">
          <img src="/images/blog-contract-signing.png" alt="AI signing a contract" class="blog-card__image" loading="lazy">
          <div class="blog-card__body">
            <span class="blog-card__tag">Document</span>
            <h2 class="blog-card__title">I send a PDF to my AI. It signs and returns it.</h2>
            <p class="blog-card__excerpt">During contract season, I need to sign dozens of contracts a day. My AI handles it — using my saved signature, it signs PDFs and sends them back in seconds.</p>
            <div class="blog-card__meta">
              <span>Apr 2026</span>
              <span>·</span>
              <span>2 min read</span>
            </div>
          </div>
        </a>

        <!-- Post 2: Pilates Booking -->
        <a href="/blog/ai-pilates-booking" class="blog-card fade-in-up">
          <img src="/images/blog-pilates-booking.png" alt="AI booking a Pilates class" class="blog-card__image" loading="lazy">
          <div class="blog-card__body">
            <span class="blog-card__tag blog-card__tag--green">Lifestyle</span>
            <h2 class="blog-card__title">My AI booked a Pilates class for me — because it knows me.</h2>
            <p class="blog-card__excerpt">I had a gap after work on Tuesday. I told my AI, and it booked my favourite class with my preferred instructor — because it remembers my preferences from past bookings.</p>
            <div class="blog-card__meta">
              <span>Apr 2026</span>
              <span>·</span>
              <span>2 min read</span>
            </div>
          </div>
        </a>

        <!-- Post 3: Stock Price Alerts -->
        <a href="/blog/ai-stock-price-alerts" class="blog-card fade-in-up">
          <img src="/images/blog-stock-price-alerts.png" alt="AI sending stock price alerts" class="blog-card__image" loading="lazy">
          <div class="blog-card__body">
            <span class="blog-card__tag blog-card__tag--blue">Finance</span>
            <h2 class="blog-card__title">My AI reports stock prices to me twice a day. I just trade.</h2>
            <p class="blog-card__excerpt">I told my AI to track 鴻海 and report the price at 10:30 and 11:50 every day. No app to open — just the numbers I need.</p>
            <div class="blog-card__meta">
              <span>Apr 2026</span>
              <span>·</span>
              <span>2 min read</span>
            </div>
          </div>
        </a>

        <!-- Post 4: Daily Market Brief -->
        <a href="/blog/ai-daily-market-brief" class="blog-card fade-in-up">
          <img src="/images/blog-daily-market-brief.png" alt="AI daily market briefing" class="blog-card__image" loading="lazy">
          <div class="blog-card__body">
            <span class="blog-card__tag blog-card__tag--blue">Finance</span>
            <h2 class="blog-card__title">My AI briefs me on gold, oil, and markets every morning.</h2>
            <p class="blog-card__excerpt">Every morning, my AI sends me gold, oil, S&amp;P 500, Hang Seng, Nikkei — with context on what moved the markets. No financial app needed.</p>
            <div class="blog-card__meta">
              <span>Apr 2026</span>
              <span>·</span>
              <span>2 min read</span>
            </div>
          </div>
        </a>

        <!-- Post 5: AI Personal Trainer -->
        <a href="/blog/ai-personal-trainer" class="blog-card fade-in-up">
          <img src="/images/blog-ai-coach.png" alt="AI acting as personal trainer" class="blog-card__image" loading="lazy">
          <div class="blog-card__body">
            <span class="blog-card__tag blog-card__tag--green">Lifestyle</span>
            <h2 class="blog-card__title">My AI knows my resting heart rate. It told me to go all-out.</h2>
            <p class="blog-card__excerpt">The same AI that reads my emails, signs my contracts, and books my Pilates classes also acts as my personal trainer — analyzing training load, HRV, and recovery data.</p>
            <div class="blog-card__meta">
              <span>Apr 2026</span>
              <span>·</span>
              <span>2 min read</span>
            </div>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="padding: 80px 0;">
    <div class="container" style="text-align:center;">
      <h2 class="section-heading" style="justify-content:center;">Want an AI that does this for you?</h2>
      <p class="section-subtitle">We set up your personal AI assistant in one session. Same day. No technical knowledge needed.</p>
      <a href="https://wa.me/85297381028" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-large">
        <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" style="margin-right:8px;vertical-align:middle;"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        <span>Book installation</span>
      </a>
    </div>
  </section>
</BaseLayout>
