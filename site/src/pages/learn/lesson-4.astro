---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="The Copy-Paste Trick — Luxon Learn" description="Upload an example. Say 'do it like this.' That's it.">
  <Fragment slot="head">
    <link rel="stylesheet" href="/legacy-shared.css" />
    <link rel="stylesheet" href="/learn/learn-styles.css" />
  </Fragment>

  <!-- Lesson Hero -->
  <section class="lesson-hero">
    <div class="lesson-breadcrumb">
      <a href="/learn">Learn</a>
      <span>/</span>
      <span>Lesson 4</span>
    </div>
    <div class="lesson-badge">Level 2</div>
    <h1>The Copy-Paste Trick</h1>
    <p class="lesson-subtitle">Upload an example. Say 'do it like this.' That's it.</p>
  </section>

  <div class="lesson-content">

    <!-- Visual: Example → Matching Output -->
    <div class="lesson-visual">
      <svg viewBox="0 0 640 280" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Person uploading example -->
        <rect x="20" y="20" width="260" height="240" rx="16" fill="#f0fdf4" stroke="#bbf7d0"/>
        <text x="40" y="50" font-family="Inter,sans-serif" font-size="11" fill="#16a34a" font-weight="700">✓ YOUR EXAMPLE</text>
        <!-- Document being uploaded -->
        <rect x="40" y="68" width="220" height="100" rx="8" fill="#fff" stroke="#86efac"/>
        <rect x="56" y="84" width="120" height="8" rx="3" fill="#16a34a" opacity="0.3"/>
        <rect x="56" y="98" width="180" height="6" rx="3" fill="#d1d5db"/>
        <rect x="56" y="110" width="160" height="6" rx="3" fill="#d1d5db"/>
        <rect x="56" y="122" width="140" height="6" rx="3" fill="#d1d5db"/>
        <rect x="56" y="138" width="80" height="18" rx="4" fill="#16a34a" opacity="0.15"/>
        <text x="64" y="151" font-family="monospace" font-size="9" fill="#16a34a">📄 example.pdf</text>
        <!-- Prompt -->
        <rect x="40" y="184" width="220" height="32" rx="8" fill="#fff" stroke="#86efac"/>
        <text x="56" y="204" font-family="Inter,sans-serif" font-size="11" fill="#16a34a" font-weight="600">"Do it like this."</text>

        <!-- Arrow -->
        <path d="M290 140 L340 140" stroke="#4285f4" stroke-width="3" marker-end="url(#arrowhead4)"/>
        <defs><marker id="arrowhead4" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto"><polygon points="0 0, 10 3.5, 0 7" fill="#4285f4"/></marker></defs>

        <!-- AI producing matching output -->
        <rect x="350" y="20" width="270" height="240" rx="16" fill="#eff6ff" stroke="#bfdbfe"/>
        <text x="370" y="50" font-family="Inter,sans-serif" font-size="11" fill="#2563eb" font-weight="700">🤖 AI OUTPUT</text>
        <!-- Matching document -->
        <rect x="370" y="68" width="230" height="100" rx="8" fill="#fff" stroke="#93c5fd"/>
        <rect x="386" y="84" width="120" height="8" rx="3" fill="#2563eb" opacity="0.3"/>
        <rect x="386" y="98" width="190" height="6" rx="3" fill="#d1d5db"/>
        <rect x="386" y="110" width="170" height="6" rx="3" fill="#d1d5db"/>
        <rect x="386" y="122" width="150" height="6" rx="3" fill="#d1d5db"/>
        <rect x="386" y="138" width="80" height="18" rx="4" fill="#2563eb" opacity="0.15"/>
        <text x="394" y="151" font-family="monospace" font-size="9" fill="#2563eb">📄 new-output.pdf</text>
        <!-- Match indicator -->
        <text x="370" y="196" font-family="Inter,sans-serif" font-size="12" fill="#2563eb" font-weight="600">✓ Same format, structure & style</text>
        <text x="370" y="214" font-family="Inter,sans-serif" font-size="10" fill="#6b7280">New content. Your template. Zero effort.</text>
      </svg>
      <p class="lesson-visual-caption">Paste one good example. The AI clones the format perfectly — every time.</p>
    </div>

    <!-- Steps -->
    <div class="lesson-steps">
      <div class="lesson-step">
        <div class="lesson-step__number">1</div>
        <div class="lesson-step__content">
          <h3>Find a good example</h3>
          <p>Grab a past piece of work that turned out great — an email, report, invoice, social post. It doesn't need to be perfect. It just needs to show the style and structure you want.</p>
        </div>
      </div>
      <div class="lesson-step">
        <div class="lesson-step__number">2</div>
        <div class="lesson-step__content">
          <h3>Upload it to the chat</h3>
          <p>Drop the file directly into the chat, or paste the text. Claude and ChatGPT both handle PDFs, docs, and pasted text well.</p>
        </div>
      </div>
      <div class="lesson-step">
        <div class="lesson-step__number">3</div>
        <div class="lesson-step__content">
          <h3>Say "do it like this"</h3>
          <p>Three words is all you need: "Fill out this form using this as a template." The AI will match the tone, layout, and structure automatically.</p>
        </div>
      </div>
    </div>

    <!-- Compare -->
    <div class="lesson-compare">
      <div class="lesson-compare__box lesson-compare__box--bad">
        <div class="lesson-compare__label">Before</div>
        <p class="lesson-compare__text">"Write me a report with a title at the top, then an executive summary in bold, then 3 sections with bullet points, using formal language and keeping it under 2 pages..."</p>
      </div>
      <div class="lesson-compare__box lesson-compare__box--good">
        <div class="lesson-compare__label">After</div>
        <p class="lesson-compare__text">"Do it like this." <span style="opacity:0.6;font-size:0.85em;">(3 words + your example)</span></p>
      </div>
    </div>

    <!-- Tip -->
    <div class="lesson-tip">
      <div class="lesson-tip__icon">💡</div>
      <div class="lesson-tip__text"><strong>Works with anything:</strong> Invoices, emails, reports, social posts, meeting notes, contracts. If you have a good example, the AI can replicate the format.</div>
    </div>

    <!-- CTA -->
    <div class="lesson-cta">
      <h3>Want this set up for you?</h3>
      <p>We configure everything — personalization, projects, and workflows — in one session.</p>
      <a href="https://wa.me/85297381028" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Book installation</a>
    </div>
  </div>

  <!-- Lesson Nav -->
  <div class="lesson-nav">
    <a href="/learn/lesson-3" class="prev"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M19 12H5m7-7-7 7 7 7"/></svg> Personalize Your AI</a>
    <a href="/learn/lesson-5" class="next">Say What TO Do <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M5 12h14m-7-7 7 7-7 7"/></svg></a>
  </div>
</BaseLayout>
