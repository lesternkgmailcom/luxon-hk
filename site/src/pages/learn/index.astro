---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Learn AI — Luxon.hk" description="AI crash course: 8 lessons by an AI developer. Practical communication techniques you can use today — no technical background needed.">
  <Fragment slot="head">
    <link rel="stylesheet" href="/legacy-shared.css" />
    <link rel="stylesheet" href="/learn/learn-styles.css" />
  </Fragment>

  <!-- Hero -->
  <section class="learn-hero">
    <div class="container">
      <h1>AI Crash Course: 8 Lessons</h1>
      <p>An AI developer teaches you 8 techniques for communicating with AI. Tackles beginner mistakes head-on — use them today.</p>
    </div>
  </section>

  <!-- Lesson Grid -->
  <section class="lesson-grid container--wide">
    <a href="/learn/lesson-1" class="lesson-card fade-in-up">
      <div class="lesson-card__number">1</div>
      <div class="lesson-card__title">AI vs Google Search</div>
      <div class="lesson-card__desc">Why "more words" gives you dramatically better results than a short question.</div>
      <div class="lesson-card__arrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
      </div>
    </a>
    <a href="/learn/lesson-2" class="lesson-card fade-in-up">
      <div class="lesson-card__number">2</div>
      <div class="lesson-card__title">Set Up a Project First</div>
      <div class="lesson-card__desc">Stop learning prompts. Projects are the real secret — and most tutorials skip this.</div>
      <div class="lesson-card__arrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
      </div>
    </a>
    <a href="/learn/lesson-3" class="lesson-card fade-in-up">
      <div class="lesson-card__number">3</div>
      <div class="lesson-card__title">Personalize Your AI</div>
      <div class="lesson-card__desc">The most powerful AI setting takes 2 minutes — and almost nobody uses it.</div>
      <div class="lesson-card__arrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
      </div>
    </a>
    <a href="/learn/lesson-4" class="lesson-card fade-in-up">
      <div class="lesson-card__number">4</div>
      <div class="lesson-card__title">The Copy-Paste Trick</div>
      <div class="lesson-card__desc">Upload an example. Say "do it like this." That's it. No fancy prompting needed.</div>
      <div class="lesson-card__arrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
      </div>
    </a>
    <a href="/learn/lesson-5" class="lesson-card fade-in-up">
      <div class="lesson-card__number">5</div>
      <div class="lesson-card__title">Say What TO Do</div>
      <div class="lesson-card__desc">Tell the AI what you want — not what you don't want. This one rule changes everything.</div>
      <div class="lesson-card__arrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
      </div>
    </a>
    <a href="/learn/lesson-6" class="lesson-card fade-in-up">
      <div class="lesson-card__number">6</div>
      <div class="lesson-card__title">Let AI Write Its Own Instructions</div>
      <div class="lesson-card__desc">Don't know what to tell your AI? Ask it to figure it out for you.</div>
      <div class="lesson-card__arrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
      </div>
    </a>
    <a href="/learn/lesson-7" class="lesson-card fade-in-up">
      <div class="lesson-card__number">7</div>
      <div class="lesson-card__title">Smarter ≠ Better</div>
      <div class="lesson-card__desc">The expensive model isn't always the right choice. Sometimes "fast" beats "pro."</div>
      <div class="lesson-card__arrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
      </div>
    </a>
    <a href="/learn/lesson-8" class="lesson-card fade-in-up">
      <div class="lesson-card__number">8</div>
      <div class="lesson-card__title">Search Your Past Chats</div>
      <div class="lesson-card__desc">Everything you've ever asked is still there. Here's how to find it.</div>
      <div class="lesson-card__arrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
      </div>
    </a>
  </section>

  <!-- CTA -->
  <section class="book-cta-section">
    <div class="container">
      <h2>Want us to set this up for you?</h2>
      <p>We configure your AI assistant with personalization, projects, and workflows — all in one session.</p>
      <a href="https://wa.me/85297381028" class="btn btn-primary btn-large" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" style="margin-right:8px;"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        <span>Book installation</span>
      </a>
    </div>
  </section>
</BaseLayout>
