---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Personalize Your AI — Luxon Learn" description="The most powerful AI setting takes 2 minutes — and almost nobody uses it.">
  <Fragment slot="head">
    <link rel="stylesheet" href="/legacy-shared.css" />
    <link rel="stylesheet" href="/learn/learn-styles.css" />
  </Fragment>

  <!-- Lesson Hero -->
  <section class="lesson-hero">
    <div class="lesson-breadcrumb">
      <a href="/learn">Learn</a>
      <span>/</span>
      <span>Lesson 3</span>
    </div>
    <div class="lesson-badge">Level 1</div>
    <h1>Personalize Your AI</h1>
    <p class="lesson-subtitle">The most powerful AI setting takes 2 minutes — and almost nobody uses it.</p>
  </section>

  <div class="lesson-content">

    <!-- Visual: Generic vs Personalized -->
    <div class="lesson-visual">
      <svg viewBox="0 0 640 280" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Generic response -->
        <rect x="20" y="20" width="280" height="240" rx="16" fill="#fef2f2" stroke="#fecaca"/>
        <text x="40" y="50" font-family="Inter,sans-serif" font-size="11" fill="#dc2626" font-weight="700">❌ GENERIC</text>
        <rect x="40" y="66" width="240" height="70" rx="8" fill="#fff" stroke="#e5e7eb"/>
        <text x="52" y="86" font-family="Inter,sans-serif" font-size="10" fill="#6b7280">Dear Sir/Madam, I hope this email</text>
        <text x="52" y="100" font-family="Inter,sans-serif" font-size="10" fill="#6b7280">finds you well. I am writing to</text>
        <text x="52" y="114" font-family="Inter,sans-serif" font-size="10" fill="#6b7280">inform you that...</text>
        <text x="40" y="160" font-family="Inter,sans-serif" font-size="10" fill="#9ca3af">Formal. Generic. Impersonal.</text>
        <text x="40" y="178" font-family="Inter,sans-serif" font-size="10" fill="#9ca3af">Could be written by anyone, for anyone.</text>

        <!-- Personalized response -->
        <rect x="340" y="20" width="280" height="240" rx="16" fill="#f0fdf4" stroke="#bbf7d0"/>
        <text x="360" y="50" font-family="Inter,sans-serif" font-size="11" fill="#16a34a" font-weight="700">✓ PERSONALIZED</text>
        <rect x="360" y="66" width="240" height="70" rx="8" fill="#fff" stroke="#86efac"/>
        <text x="372" y="86" font-family="Inter,sans-serif" font-size="10" fill="#3c4043">Hey! Quick update on the Q2 deck —</text>
        <text x="372" y="100" font-family="Inter,sans-serif" font-size="10" fill="#3c4043">numbers are looking solid. Hit me</text>
        <text x="372" y="114" font-family="Inter,sans-serif" font-size="10" fill="#3c4043">back when you've had a chance to review.</text>
        <text x="360" y="160" font-family="Inter,sans-serif" font-size="10" fill="#16a34a" font-weight="600">Sounds like YOU. Matches your style.</text>
        <text x="360" y="178" font-family="Inter,sans-serif" font-size="10" fill="#16a34a" font-weight="600">AI learned your tone, role & preferences.</text>

        <!-- Arrow -->
        <path d="M310 140 L330 140" stroke="#4285f4" stroke-width="2" marker-end="url(#arrowhead3)"/>
        <defs><marker id="arrowhead3" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto"><polygon points="0 0, 8 3, 0 6" fill="#4285f4"/></marker></defs>
      </svg>
      <p class="lesson-visual-caption">Same request. Without personalization, you get generic. With it, you get you.</p>
    </div>

    <!-- Steps -->
    <div class="lesson-steps">
      <div class="lesson-step">
        <div class="lesson-step__number">1</div>
        <div class="lesson-step__content">
          <h3>What is personalization?</h3>
          <p>Custom instructions are like an AI's job description. Tell it who you are, what you do, and how you like things done — and it applies that to every single response. Forever.</p>
        </div>
      </div>
      <div class="lesson-step">
        <div class="lesson-step__number">2</div>
        <div class="lesson-step__content">
          <h3>How to set it up</h3>
          <p><strong>Claude:</strong> Open Project Settings → add your instructions.<br><strong>ChatGPT:</strong> Settings → Personalize → Custom Instructions. Takes about 2 minutes.</p>
        </div>
      </div>
      <div class="lesson-step">
        <div class="lesson-step__number">3</div>
        <div class="lesson-step__content">
          <h3>What to include</h3>
          <p>Your role & industry, preferred tone (casual vs formal), format preferences (bullets, short paragraphs), and things to always avoid. Be specific — "I prefer bullet points" beats "be concise."</p>
        </div>
      </div>
    </div>

    <!-- Compare -->
    <div class="lesson-compare">
      <div class="lesson-compare__box lesson-compare__box--bad">
        <div class="lesson-compare__label">Before</div>
        <p class="lesson-compare__text">"Write an email"</p>
      </div>
      <div class="lesson-compare__box lesson-compare__box--good">
        <div class="lesson-compare__label">After personalization</div>
        <p class="lesson-compare__text">"Write a short email in my usual casual tone, under 200 words"</p>
      </div>
    </div>

    <!-- Tip -->
    <div class="lesson-tip">
      <div class="lesson-tip__icon">💡</div>
      <div class="lesson-tip__text"><strong>Start here:</strong> Type "Help me write the best custom instructions for this project" — let the AI write its own instructions. It knows what it needs.</div>
    </div>

    <!-- CTA -->
    <div class="lesson-cta">
      <h3>Want this set up for you?</h3>
      <p>We configure everything — personalization, projects, and workflows — in one session.</p>
      <a href="https://wa.me/85297381028" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Book installation</a>
    </div>
  </div>

  <!-- Lesson Nav -->
  <div class="lesson-nav">
    <a href="/learn/lesson-2" class="prev"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M19 12H5m7-7-7 7 7 7"/></svg> Set Up a Project First</a>
    <a href="/learn/lesson-4" class="next">The Copy-Paste Trick <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M5 12h14m-7-7 7 7-7 7"/></svg></a>
  </div>
</BaseLayout>
