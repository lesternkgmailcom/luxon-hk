---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Search Your Past Chats — Luxon Learn" description="Everything you've ever asked is still there. Here's how to find it.">
  <Fragment slot="head">
    <link rel="stylesheet" href="/legacy-shared.css" />
    <link rel="stylesheet" href="/learn/learn-styles.css" />
  </Fragment>

  <!-- Lesson Hero -->
  <section class="lesson-hero">
    <div class="lesson-breadcrumb">
      <a href="/learn">Learn</a>
      <span>/</span>
      <span>Lesson 8</span>
    </div>
    <div class="lesson-badge">Level 1</div>
    <h1>Search Your Past Chats</h1>
    <p class="lesson-subtitle">Everything you've ever asked is still there. Here's how to find it.</p>
  </section>

  <div class="lesson-content">

    <!-- Visual: Lost in chats vs Search -->
    <div class="lesson-visual">
      <svg viewBox="0 0 640 280" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Lost scenario (left) -->
        <rect x="20" y="20" width="280" height="240" rx="16" fill="#fef2f2" stroke="#fecaca"/>
        <text x="160" y="52" font-family="Inter,sans-serif" font-size="12" fill="#dc2626" font-weight="700" text-anchor="middle">❌ WITHOUT SEARCH</text>
        <!-- Stacked chat bubbles -->
        <rect x="50" y="70" width="220" height="24" rx="12" fill="#fff" stroke="#fecaca"/>
        <text x="70" y="86" font-family="Inter,sans-serif" font-size="9" fill="#9ca3af">Jan 15 — "help me write email"</text>
        <rect x="50" y="100" width="220" height="24" rx="12" fill="#fff" stroke="#fecaca"/>
        <text x="70" y="116" font-family="Inter,sans-serif" font-size="9" fill="#9ca3af">Feb 3 — "summarize report"</text>
        <rect x="50" y="130" width="220" height="24" rx="12" fill="#fff" stroke="#fecaca"/>
        <text x="70" y="146" font-family="Inter,sans-serif" font-size="9" fill="#9ca3af">Feb 28 — "translate contract"</text>
        <rect x="50" y="160" width="220" height="24" rx="12" fill="#fff" stroke="#fecaca"/>
        <text x="70" y="176" font-family="Inter,sans-serif" font-size="9" fill="#9ca3af">Mar 12 — "fix spreadsheet"</text>
        <!-- Scrolling icon -->
        <text x="160" y="210" font-family="Inter,sans-serif" font-size="18" text-anchor="middle">🔄</text>
        <text x="160" y="232" font-family="Inter,sans-serif" font-size="10" fill="#dc2626" text-anchor="middle">Scrolling forever...</text>

        <!-- Arrow -->
        <path d="M310 140 L330 140" stroke="#4285f4" stroke-width="2" marker-end="url(#arrow8)"/>
        <defs><marker id="arrow8" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto"><polygon points="0 0, 8 3, 0 6" fill="#4285f4"/></marker></defs>

        <!-- Search scenario (right) -->
        <rect x="340" y="20" width="280" height="240" rx="16" fill="#f0fdf4" stroke="#bbf7d0"/>
        <text x="480" y="52" font-family="Inter,sans-serif" font-size="12" fill="#16a34a" font-weight="700" text-anchor="middle">✓ WITH SEARCH</text>
        <!-- Search bar -->
        <rect x="370" y="70" width="220" height="32" rx="16" fill="#fff" stroke="#86efac"/>
        <text x="395" y="90" font-family="Inter,sans-serif" font-size="10" fill="#16a34a">🔍 "contract translation"</text>
        <!-- Results -->
        <rect x="370" y="114" width="220" height="28" rx="6" fill="#fff" stroke="#86efac"/>
        <text x="385" y="132" font-family="Inter,sans-serif" font-size="9" fill="#16a34a">📄 Feb 28 — contract translation</text>
        <rect x="370" y="148" width="220" height="28" rx="6" fill="#fff" stroke="#86efac"/>
        <text x="385" y="166" font-family="Inter,sans-serif" font-size="9" fill="#16a34a">📄 Mar 5 — NDA review</text>
        <!-- Found icon -->
        <text x="480" y="210" font-family="Inter,sans-serif" font-size="18" text-anchor="middle">🎯</text>
        <text x="480" y="232" font-family="Inter,sans-serif" font-size="10" fill="#16a34a" font-weight="600" text-anchor="middle">Found in 2 seconds</text>
      </svg>
      <p class="lesson-visual-caption">Your AI remembers everything. Don't re-ask — just search. It's like having a second brain that never forgets.</p>
    </div>

    <!-- Steps -->
    <div class="lesson-steps">
      <div class="lesson-step">
        <div class="lesson-step__number">1</div>
        <div class="lesson-step__content">
          <h3>Nothing is lost</h3>
          <p>Every conversation you've had with your AI is saved. Every question, every answer, every document you uploaded. It's all still there — you just need to know how to look.</p>
        </div>
      </div>
      <div class="lesson-step">
        <div class="lesson-step__number">2</div>
        <div class="lesson-step__content">
          <h3>How to search</h3>
          <p><strong>ChatGPT:</strong> Use the search bar at the top of the sidebar. <strong>Claude:</strong> Projects keep all related chats together — search within a project. <strong>Tip:</strong> Search for keywords from your original question, not the topic.</p>
        </div>
      </div>
      <div class="lesson-step">
        <div class="lesson-step__number">3</div>
        <div class="lesson-step__content">
          <h3>Ask the AI directly</h3>
          <p>In the same project or conversation thread, just ask: "What do you remember about [topic]?" The AI can reference its own history and give you a summary. No manual searching needed.</p>
        </div>
      </div>
    </div>

    <!-- Tip -->
    <div class="lesson-tip">
      <div class="lesson-tip__icon">💡</div>
      <div class="lesson-tip__text"><strong>Pro tip:</strong> Projects (Lesson 2) make search 10× easier. Instead of searching all your chats, search within one project — all related conversations are already grouped together.</div>
    </div>

    <!-- CTA -->
    <div class="lesson-cta">
      <h3>Want this set up for you?</h3>
      <p>We configure everything — personalization, projects, and workflows — in one session.</p>
      <a href="https://wa.me/85297381028" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Book installation</a>
    </div>
  </div>

  <!-- Lesson Nav -->
  <div class="lesson-nav">
    <a href="/learn/lesson-7" class="prev"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M19 12H5m7-7-7 7 7 7"/></svg> Smarter ≠ Better</a>
    <a href="/learn" class="next">Back to All Lessons <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M5 12h14m-7-7 7 7-7 7"/></svg></a>
  </div>
</BaseLayout>
