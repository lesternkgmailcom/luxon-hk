---
/**
 * PricingCard — single tier card for the AI Workers pricing page.
 */
import { type TranslationKeys } from '../../i18n/translations';

interface Props {
  name: string;
  price: string;
  priceNote: string;
  features: string[];
  ctaText: string;
  ctaHref: string;
  featured?: boolean;
  t?: TranslationKeys;
}

const { name, price, priceNote, features, ctaText, ctaHref, featured = false, t } = Astro.props;
const popularLabel = t?.pricing?.popularLabel || 'Most Popular';
---

<div class:list={[
  'relative bg-luxon-card rounded-xl border p-6 lg:p-8 flex flex-col',
  featured
    ? 'border-luxon-green shadow-lg scale-[1.03] z-10'
    : 'border-luxon-border shadow-sm',
]}>
  {featured && (
    <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 bg-luxon-green text-white text-xs font-bold rounded-full uppercase tracking-wide">
      {popularLabel}
    </div>
  )}

  <h3 class="font-heading text-xl font-bold text-luxon-dark mb-2">{name}</h3>

  <div class="mb-1">
    <span class="font-heading text-4xl font-bold text-luxon-dark">{price}</span>
  </div>
  <p class="text-luxon-muted text-sm mb-6">{priceNote}</p>

  <ul class="space-y-3 mb-8 flex-1">
    {features.map((feature) => (
      <li class="flex items-start gap-2.5 text-sm text-luxon-text">
        <svg class="w-5 h-5 text-luxon-green shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
        {feature}
      </li>
    ))}
  </ul>

  <a
    href={ctaHref}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
      'inline-flex items-center justify-center w-full px-6 py-3 font-semibold rounded-full text-sm transition-colors',
      featured
        ? 'bg-luxon-green text-white hover:bg-luxon-green-accent'
        : 'border border-luxon-border text-luxon-dark hover:bg-luxon-bg',
    ]}
  >
    {ctaText}
  </a>
</div>
