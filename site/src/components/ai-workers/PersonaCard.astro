---
/**
 * PersonaCard — who the AI Worker is for. Icon + title + description.
 */
interface Props {
  title: string;
  description: string;
  icon: string; // raw inline SVG markup
}

const { title, description, icon } = Astro.props;
---

<div class="bg-luxon-card rounded-xl border border-luxon-border p-6 lg:p-8 shadow-sm">
  <div class="w-12 h-12 rounded-lg bg-luxon-purple/10 flex items-center justify-center mb-4">
    <Fragment set:html={icon} />
  </div>
  <h3 class="font-heading text-lg font-bold text-luxon-dark mb-2">{title}</h3>
  <p class="text-luxon-muted leading-relaxed text-sm">{description}</p>
</div>
