---
/**
 * ComparisonTable — 3-column comparison: DIY AI Tools vs ChatGPT/Copilot vs Luxon AI Worker.
 * The Luxon column is visually highlighted with a green accent.
 */
import { type TranslationKeys, translations } from '../../i18n/translations';

interface Props {
  t?: TranslationKeys;
}

const { t = translations.en } = Astro.props;
const aw = t.aiWorkers;

const rows = [
  { label: 'Setup', diy: 'Complex', chatgpt: 'None needed', luxon: 'We handle everything' },
  { label: 'Connects to your tools', diy: 'Limited', chatgpt: 'Partial', luxon: 'Full integration' },
  { label: 'Autonomous action', diy: false, chatgpt: false, luxon: true },
  { label: 'Security', diy: 'Your problem', chatgpt: 'Shared data', luxon: 'Sandboxed, hardened' },
  { label: 'Support', diy: 'None', chatgpt: 'Generic', luxon: 'Dedicated, same-day' },
];

function renderCell(value: string | boolean) {
  if (typeof value === 'boolean') {
    if (value) {
      return `<span class="inline-flex items-center gap-1.5 text-luxon-green font-semibold"><svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg> Yes</span>`;
    }
    return `<span class="inline-flex items-center gap-1.5 text-luxon-muted"><svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg> No</span>`;
  }
  return value;
}
---

<section class="px-6 py-20 md:py-28">
  <div class="max-w-[900px] mx-auto">
    <h2 class="font-heading text-3xl md:text-4xl font-bold text-luxon-dark text-center mb-4">
      {aw.comparisonTitle}
    </h2>
    <p class="text-luxon-muted text-center mb-12 max-w-[600px] mx-auto">
      {aw.comparisonSubtitle}
    </p>

    <div class="overflow-x-auto rounded-xl border border-luxon-border">
      <table class="w-full min-w-[600px] text-sm">
        <thead>
          <tr class="bg-luxon-bg">
            <th class="text-left px-6 py-4 font-heading font-semibold text-luxon-muted"></th>
            <th class="text-center px-6 py-4 font-heading font-semibold text-luxon-muted">DIY AI Tools</th>
            <th class="text-center px-6 py-4 font-heading font-semibold text-luxon-muted">ChatGPT / Copilot</th>
            <th class="text-center px-6 py-4 font-heading font-semibold text-luxon-green bg-luxon-green/5">
              Luxon AI Worker
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row, i) => (
            <tr class={`border-t border-luxon-border ${i % 2 === 1 ? 'bg-luxon-bg/50' : 'bg-luxon-card'}`}>
              <td class="px-6 py-4 font-heading font-semibold text-luxon-dark">{row.label}</td>
              <td class="px-6 py-4 text-center text-luxon-muted">
                <Fragment set:html={renderCell(row.diy)} />
              </td>
              <td class="px-6 py-4 text-center text-luxon-muted">
                <Fragment set:html={renderCell(row.chatgpt)} />
              </td>
              <td class="px-6 py-4 text-center text-luxon-text font-medium bg-luxon-green/5 border-l-[3px] border-l-luxon-green">
                <Fragment set:html={renderCell(row.luxon)} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
