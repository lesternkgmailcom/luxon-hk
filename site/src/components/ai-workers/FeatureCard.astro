---
/**
 * FeatureCard — icon + title + description card for AI Workers features.
 * Used in the "What Your AI Worker Can Do" section.
 */
interface Props {
  title: string;
  description: string;
  icon: string; // raw inline SVG markup
}

const { title, description, icon } = Astro.props;
---

<div class="group bg-luxon-card rounded-xl border border-luxon-border p-6 lg:p-8 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-200">
  <div class="w-12 h-12 rounded-lg bg-luxon-green/10 flex items-center justify-center mb-4">
    <Fragment set:html={icon} />
  </div>
  <h3 class="font-heading text-lg font-bold text-luxon-dark mb-2">{title}</h3>
  <p class="text-luxon-muted leading-relaxed text-sm">{description}</p>
</div>
