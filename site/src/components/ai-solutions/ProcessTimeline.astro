---
/**
 * ProcessTimeline — 5-step vertical (mobile) / horizontal (desktop) timeline.
 * Each step has a number, title, time label, and description.
 */
import { type TranslationKeys, translations } from '../../i18n/translations';

interface Props {
  t?: TranslationKeys;
}

const { t = translations.en } = Astro.props;
const proc = t.process;

const steps = proc.timelineSteps.map((step, i) => ({
  number: String(i + 1),
  title: step.title,
  time: step.time,
  description: step.description,
}));
---

<section class="px-6 py-20 md:py-28">
  <div class="max-w-[1100px] mx-auto">
    <h2 class="font-heading text-3xl md:text-4xl font-bold text-luxon-dark text-center mb-16">
      {proc.timelineTitle}
    </h2>

    <!-- Desktop: horizontal timeline -->
    <div class="hidden lg:flex items-start justify-between">
      {steps.map((step, i) => (
        <div class="flex-1 flex flex-col items-center text-center relative">
          {/* Connecting line */}
          {i < steps.length - 1 && (
            <div class="absolute top-5 left-[calc(50%+28px)] right-[calc(-50%+28px)] h-px bg-luxon-border"></div>
          )}
          {/* Circle */}
          <div class="w-10 h-10 rounded-full bg-luxon-green text-white font-heading font-bold text-lg flex items-center justify-center z-10 mb-5">
            {step.number}
          </div>
          <span class="text-xs font-semibold text-luxon-green-accent uppercase tracking-wider mb-2">{step.time}</span>
          <h3 class="font-heading text-lg font-semibold text-luxon-dark mb-2">
            {step.title}
          </h3>
          <p class="text-sm text-luxon-muted max-w-[200px] leading-relaxed">
            {step.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Tablet: 5-column vertical cards -->
    <div class="hidden md:grid lg:hidden md:grid-cols-3 gap-6">
      {steps.map((step) => (
        <div class="flex gap-4 bg-luxon-card rounded-xl border border-luxon-border p-5">
          <div class="flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-luxon-green text-white font-heading font-bold text-lg flex items-center justify-center shrink-0">
              {step.number}
            </div>
          </div>
          <div>
            <span class="text-xs font-semibold text-luxon-green-accent uppercase tracking-wider">{step.time}</span>
            <h3 class="font-heading text-lg font-semibold text-luxon-dark mt-1 mb-1.5">
              {step.title}
            </h3>
            <p class="text-sm text-luxon-muted leading-relaxed">
              {step.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Mobile: stacked vertical timeline -->
    <div class="flex flex-col gap-8 md:hidden">
      {steps.map((step, i) => (
        <div class="flex gap-5">
          <div class="flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-luxon-green text-white font-heading font-bold text-lg flex items-center justify-center shrink-0">
              {step.number}
            </div>
            {i < steps.length - 1 && (
              <div class="w-px flex-1 bg-luxon-border mt-3"></div>
            )}
          </div>
          <div class="pb-2">
            <span class="text-xs font-semibold text-luxon-green-accent uppercase tracking-wider">{step.time}</span>
            <h3 class="font-heading text-lg font-semibold text-luxon-dark mt-1 mb-1.5">
              {step.title}
            </h3>
            <p class="text-sm text-luxon-muted leading-relaxed">
              {step.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
