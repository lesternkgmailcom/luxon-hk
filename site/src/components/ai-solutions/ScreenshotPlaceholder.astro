---
/**
 * ScreenshotPlaceholder — gray gradient box for future dashboard screenshots.
 * Accepts a label and optional aspect ratio. Styled to look intentional, not broken.
 */
interface Props {
  label: string;
  aspect?: string; // Tailwind aspect-ratio class, e.g. 'aspect-[16/10]' or 'aspect-[16/9]'
}

const { label, aspect = 'aspect-[16/10]' } = Astro.props;
---

<!-- TODO: Replace with actual dashboard screenshot -->
<div class={`${aspect} bg-gradient-to-br from-gray-100 to-gray-200 rounded-xl border border-gray-200 flex flex-col items-center justify-center gap-3`}>
  <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="3" width="18" height="18" rx="2"/>
    <circle cx="8.5" cy="8.5" r="1.5"/>
    <path d="M21 15l-5-5L5 21"/>
  </svg>
  <span class="text-sm font-medium text-gray-400 text-center px-4">{label}</span>
</div>
