---
/**
 * CaseStudyCard — teaser card for case studies listing and inline teasers.
 * Shows title, description, optional tag, and "Read case study" link.
 * Optional colored accent area (gray gradient placeholder for screenshot).
 */
import { type TranslationKeys } from '../../i18n/translations';

interface Props {
  title: string;
  description: string;
  href: string;
  tag?: string;
  showImage?: boolean;
  readLabel?: string;
  imageLabel?: string;
}

const { title, description, href, tag, showImage = false, readLabel = 'Read case study', imageLabel = 'Dashboard preview' } = Astro.props;
---

<a
  href={href}
  class="group block bg-luxon-card rounded-xl border border-luxon-border shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-200 overflow-hidden"
>
  {showImage && (
    <div class="bg-gradient-to-br from-gray-100 to-gray-200 aspect-[16/10] flex items-center justify-center border-b border-luxon-border">
      <!-- TODO: Replace with actual case study screenshot -->
      <div class="flex flex-col items-center gap-2 text-gray-400">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <path d="M21 15l-5-5L5 21"/>
        </svg>
        <span class="text-xs font-medium">{imageLabel}</span>
      </div>
    </div>
  )}
  <div class="p-6">
    {tag && (
      <span class="inline-block text-xs uppercase tracking-widest text-luxon-green-accent font-semibold mb-3">
        {tag}
      </span>
    )}
    <h3 class="font-heading text-lg font-bold text-luxon-dark mb-2 group-hover:text-luxon-green transition-colors">
      {title}
    </h3>
    <p class="text-luxon-muted leading-relaxed text-sm mb-4">{description}</p>
    <span class="inline-flex items-center text-sm font-semibold text-luxon-green group-hover:text-luxon-green-accent transition-colors">
      {readLabel}
      <svg class="w-4 h-4 ml-1.5 group-hover:translate-x-1 transition-transform" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 8h10M9 4l4 4-4 4"/>
      </svg>
    </span>
  </div>
</a>
