---
/**
 * Product Teasers — two side-by-side cards for AI Workers and AI Solutions.
 */
import { type TranslationKeys, translations, type Locale, defaultLocale } from '../../i18n/translations';

interface Props {
  t?: TranslationKeys;
  locale?: Locale;
}

const { t = translations.en, locale = defaultLocale } = Astro.props;
const pt = t.home.productTeasers;
const lp = (path: string) => locale === 'en' ? path : `/${locale}${path}`;
---

<section class="px-6 py-20 md:py-28">
  <div class="max-w-[1100px] mx-auto grid md:grid-cols-2 gap-6 lg:gap-8">

    <!-- AI Workers card -->
    <a
      href={lp('/ai-workers')}
      class="group block bg-luxon-card rounded-xl border border-luxon-border p-8 lg:p-10 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-200"
    >
      <div class="flex items-center gap-3 mb-4">
        <div class="w-12 h-12 rounded-lg bg-luxon-green/10 flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4A7C59" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="10" rx="2" />
            <circle cx="12" cy="5" r="2" />
            <path d="M12 7v4" />
            <line x1="8" y1="16" x2="8" y2="16" />
            <line x1="16" y1="16" x2="16" y2="16" />
            <circle cx="8" cy="16" r="1" fill="#4A7C59" />
            <circle cx="16" cy="16" r="1" fill="#4A7C59" />
          </svg>
        </div>
        <h2 class="font-heading text-2xl font-bold text-luxon-dark">{pt.aiWorkers.title}</h2>
      </div>
      <p class="text-luxon-muted mb-6 leading-relaxed">
        {pt.aiWorkers.description}
      </p>
      <ul class="space-y-2.5 mb-8">
        <li class="flex items-start gap-2.5 text-luxon-text">
          <svg class="w-5 h-5 text-luxon-green shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
          {pt.aiWorkers.feature1}
        </li>
        <li class="flex items-start gap-2.5 text-luxon-text">
          <svg class="w-5 h-5 text-luxon-green shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
          {pt.aiWorkers.feature2}
        </li>
        <li class="flex items-start gap-2.5 text-luxon-text">
          <svg class="w-5 h-5 text-luxon-green shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
          {pt.aiWorkers.feature3}
        </li>
      </ul>
      <span class="inline-flex items-center text-luxon-green font-semibold text-sm group-hover:gap-2 transition-all">
        {pt.aiWorkers.learnMore}
        <svg class="w-4 h-4 ml-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
      </span>
    </a>

    <!-- AI Solutions card -->
    <a
      href={lp('/ai-solutions')}
      class="group block bg-luxon-card rounded-xl border border-luxon-border p-8 lg:p-10 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-200"
    >
      <div class="flex items-center gap-3 mb-4">
        <div class="w-12 h-12 rounded-lg bg-luxon-purple/10 flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#6B5CE7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <line x1="7" y1="17" x2="7" y2="12" />
            <line x1="12" y1="17" x2="12" y2="8" />
            <line x1="17" y1="17" x2="17" y2="5" />
          </svg>
        </div>
        <h2 class="font-heading text-2xl font-bold text-luxon-dark">{pt.aiSolutions.title}</h2>
      </div>
      <p class="text-luxon-muted mb-6 leading-relaxed">
        {pt.aiSolutions.description}
      </p>
      <ul class="space-y-2.5 mb-8">
        <li class="flex items-start gap-2.5 text-luxon-text">
          <svg class="w-5 h-5 text-luxon-purple shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
          {pt.aiSolutions.feature1}
        </li>
        <li class="flex items-start gap-2.5 text-luxon-text">
          <svg class="w-5 h-5 text-luxon-purple shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
          {pt.aiSolutions.feature2}
        </li>
        <li class="flex items-start gap-2.5 text-luxon-text">
          <svg class="w-5 h-5 text-luxon-purple shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
          {pt.aiSolutions.feature3}
        </li>
      </ul>
      <span class="inline-flex items-center text-luxon-purple font-semibold text-sm group-hover:gap-2 transition-all">
        {pt.aiSolutions.seeCaseStudies}
        <svg class="w-4 h-4 ml-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
      </span>
    </a>

  </div>
</section>
