---
/**
 * Final CTA — full-width gradient section with WhatsApp button and email.
 */
import { type TranslationKeys, translations } from '../../i18n/translations';

interface Props {
  t?: TranslationKeys;
}

const { t = translations.en } = Astro.props;
const cta = t.home.finalCta;
---

<section class="px-6 py-20 md:py-28">
  <div class="max-w-[700px] mx-auto text-center">
    <!-- Gradient background card -->
    <div
      class="relative overflow-hidden rounded-2xl px-8 py-14 md:px-14 md:py-20"
      style="background: linear-gradient(135deg, #4A7C59 0%, #3a6347 40%, #6B5CE7 100%);"
    >
      <!-- Subtle overlay pattern -->
      <div
        class="absolute inset-0 opacity-[0.06]"
        style="background: radial-gradient(circle at 20% 80%, white 0%, transparent 50%), radial-gradient(circle at 80% 20%, white 0%, transparent 50%);"
        aria-hidden="true"
      ></div>

      <div class="relative z-10">
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">
          {cta.title}
        </h2>
        <p class="text-white/80 mb-10 text-lg leading-relaxed">
          {cta.subtitle}
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-8">
          <!-- WhatsApp CTA -->
          <a
            href="https://wa.me/85297381028"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-8 py-3.5 bg-white text-luxon-dark font-semibold rounded-full text-lg hover:bg-gray-100 transition-colors"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            {cta.whatsapp}
          </a>

          <!-- Email CTA -->
          <a
            href="mailto:info@luxon.hk"
            class="inline-flex items-center gap-2.5 px-8 py-3.5 border border-white/40 text-white font-semibold rounded-full text-lg hover:bg-white/10 transition-colors"
          >
            <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path d="M3 4a2 2 0 012-2h10a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2V4zm2.5 1a.5.5 0 00-.39.812l4.5 5.5a.5.5 0 00.78 0l4.5-5.5A.5.5 0 0014 5H5.5z"/>
            </svg>
            {cta.email}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
